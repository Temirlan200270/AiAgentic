# Copy this file to .env and fill real secrets.
# Never commit .env.

# Base domain used by deploy helpers (apex only, no subdomain).
DOMAIN=example.com

# n8n
# Local defaults are HTTP on localhost.
# For Coolify/HTTPS, switch N8N_HOST + N8N_EDITOR_BASE_URL + N8N_WEBHOOK_URL to your public domain
# and set N8N_SECURE_COOKIE=true.
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_SECURE_COOKIE=false
# Mapped to n8n's native WEBHOOK_URL env inside docker-compose.yml.
N8N_WEBHOOK_URL=
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_ENABLED=true
# Internal runners keep the stack smaller. External mode would require extra runner sidecars.
N8N_RUNNERS_MODE=internal
EXECUTIONS_MODE=queue
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
N8N_WORKER_CONCURRENCY=5
QUEUE_BULL_PREFIX=n8n
GENERIC_TIMEZONE=Asia/Qyzylorda
TZ=Asia/Qyzylorda

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=personal_ai_assistant
POSTGRES_USER=assistant_user
POSTGRES_PASSWORD=

# Redis
REDIS_PASSWORD=change_me_redis_password
# Convenience variable for workflows/scripts; n8n queue mode itself uses REDIS_PASSWORD + internal redis host.
REDIS_URL=redis://:change_me_redis_password@redis:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the assistant.
# Leave empty only if you intentionally want the bot to be public.
TELEGRAM_ALLOWED_USER_IDS=

# OpenAI / ChatGPT-compatible model
OPENAI_API_KEY=
OPENAI_ROUTER_MODEL=gpt-5.4-mini
# Optional; defaults to OPENAI_SYNTHESIZER_MODEL when unset (see n8n Analysis Interpreter node).
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_SYNTHESIZER_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Search
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
TAVILY_API_KEY=
# Default geography for local web search (Search Context Builder; optional if user_profile rows exist).
DEFAULT_USER_CITY=Pavlodar
DEFAULT_USER_COUNTRY=Kazakhstan
